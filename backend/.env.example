# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the connection string
# Replace <password> with your real database user password (URL-encode special characters)
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/lavion?retryWrites=true&w=majority

# Any long random string — used to sign login sessions (JWTs). Change this to your own value.
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on locally
PORT=3000

# The two fixed staff logins (used only by the seed script to create these accounts once)
ADMIN_PASSWORD=1234
MD_PASSWORD=Praveen@2804
